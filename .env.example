# Set at least one of these two. If both are set, the pipeline round-robins between them
# incubator-by-incubator, and falls back to the other one if a run hits a rate limit -
# roughly doubling how much of a full --all run completes before both quotas are spent.
# See src/compute_radar/llm_provider.py.

# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Check https://openrouter.ai/models?max_price=0 for the current free-tier roster —
# it rotates as providers add/retire free models. This one is a reasonable default
# as of Aug 2026 but may not exist by the time you read this.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Check https://ai.google.dev/gemini-api/docs/models for the current free-tier roster.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional. Seconds between requests to the same host, so scraping stays polite.
SCRAPE_DELAY_SECONDS=2

# --- EPO Open Patent Services (optional patent-verification layer) ---
# Register a free "non-paying" application at https://developers.epo.org to get these.
# When set, the pipeline attaches a real EP-patent-filing signal to each company
# (see src/compute_radar/tools/patent_tool.py). Leave blank to skip patent enrichment.
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=
OPS_DELAY_SECONDS=1.5
